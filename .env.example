# Copy this file to .env and fill in the values, then: docker compose up -d --build

# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
TOKEN=

# Application ID (Developer Portal -> your app -> General Information)
CLIENT_ID=

# Only needed for AI announcement mode with OpenAI. Leave empty for
# simple mode or a local Ollama endpoint.
OPENAI_API_KEY=

# Optional: enables the @@track_genre@@ announcement variable.
# Create a free app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional, for PocketTTS voice cloning. The cloning-capable weights
# (huggingface.co/kyutai/pocket-tts) are gated: accept the conditions on that
# page, then create a read token at huggingface.co/settings/tokens. Without it
# PocketTTS silently loads the non-cloning weights and only its 26 built-in
# voices work.
HF_TOKEN=
